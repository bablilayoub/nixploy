{
	// Self-contained on purpose: nixploy.com is deployed from `apps/landing`
	// alone (some build setups copy just this folder), so there is no
	// `../../tsconfig.base.json` at build time. Keep the options in sync with
	// tsconfig.base.json by hand; the Next-specific overrides follow them.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["dom", "dom.iterable", "ES2023"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"moduleDetection": "force",
		"strict": true,
		// Off for this app only. Components here are vendored from shadcn-style
		// registries (@shadcn, @magicui, @aceternity, @kokonutui) and are not
		// written against this flag; the product code in packages/server and
		// apps/web keeps it.
		"noUncheckedIndexedAccess": false,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"isolatedModules": true,
		"resolveJsonModule": true,
		"verbatimModuleSyntax": true,
		"noEmit": true,
		"allowJs": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
