{
	// Same shared strictness as the panel and the server; see tsconfig.base.json.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Next-specific overrides only.
		"lib": ["dom", "dom.iterable", "ES2023"],
		"allowJs": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
