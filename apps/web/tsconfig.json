{
	// Shared strictness (strict, noUncheckedIndexedAccess, verbatimModuleSyntax,
	// forceConsistentCasingInFileNames, …) lives in the root base config so the
	// panel is checked exactly as hard as `packages/server` — whose sources this
	// project compiles too (`@nixploy/server` exports raw TS).
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		// Next-specific overrides only.
		"lib": ["dom", "dom.iterable", "ES2023"],
		"allowJs": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"paths": {
			"@/*": ["./src/*"],
			// `apps/web` has no vitest dependency of its own — the runner and its
			// types are borrowed from `@nixploy/server` (see vitest.config.ts).
			"vitest": ["../../packages/server/node_modules/vitest"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts"
	],
	"exclude": ["node_modules"]
}
