# Server-side (consumed by @nixploy/server; listed here for the app process)
DATABASE_URL=postgresql://nixploy:nixploy@localhost:5432/nixploy
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-secrets-at-rest

# Optional
# BETTER_AUTH_URL=http://localhost:3000   # public base URL (auth callbacks, trusted origin)
# PORT=3000                                # app HTTP port
# NIXPLOY_CONFIG_DIR=/etc/nixploy          # traefik YAML, app code, compose files, logs
