# Copy to apps/web/.env and fill the secrets (see CONTRIBUTING.md), or let
# `./tools/dev.sh` do it for you — it generates real random values.
#
# This file covers local development. The full operator reference for every
# variable the panel reads in production is docs/install.md → "Runtime
# environment"; install.sh / update.sh forward the ones listed there.

# ── required ─────────────────────────────────────────────────────────────────
# With the throwaway Postgres from tools/dev.sh:
#   docker run -d --name nixploy-dev-pg \
#     -e POSTGRES_USER=nixploy -e POSTGRES_PASSWORD=nixploy -e POSTGRES_DB=nixploy \
#     -p 127.0.0.1:54329:5432 postgres:17-alpine
DATABASE_URL=postgres://nixploy:nixploy@127.0.0.1:54329/nixploy

# openssl rand -hex 24
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# openssl rand -hex 16 — AES-256-GCM key for secrets at rest. Changing it makes
# every stored env var, password, token and S3 key undecryptable.
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-secrets-at-rest

# Public base URL: auth callbacks and the trusted origin check. It MUST match
# the host:port you browse to, or sign-in fails with "Invalid origin".
BETTER_AUTH_URL=http://localhost:3000

# ── optional: server ─────────────────────────────────────────────────────────
# PORT=3000
# LISTEN_HOST=0.0.0.0                      # bind address of the custom server
# NIXPLOY_CONFIG_DIR=/absolute/path/to/repo/.nixploy-data
# DATABASE_POOL_MAX=10                     # Postgres pool size of this process
# TRUSTED_PROXIES=1                        # trust X-Forwarded-For (set by install.sh)
# TZ=UTC                                   # timezone every cron runs in

# ── optional: logging ────────────────────────────────────────────────────────
# LOG_LEVEL=info                           # debug | info | warn | error
# LOG_FORMAT=json                          # one JSON object per line

# ── optional: local development ──────────────────────────────────────────────
# Skip the Traefik bootstrap on boot: UI-only mode on macOS, where the proxy
# would fight local servers for :80/:443 (docs/development.md).
# NIXPLOY_DISABLE_TRAEFIK_BOOT=1
# NIXPLOY_NETWORK=nixploy-network          # shared tenant overlay
# NIXPLOY_WILDCARD_DOMAIN=traefik.me       # preview/demo wildcard DNS zone
# NIXPLOY_DEPLOY_CONCURRENCY=2             # parallel deploy workers
# DOCKER_SOCKET=/var/run/docker.sock

# ── optional: platform self-alerts ───────────────────────────────────────────
# NIXPLOY_INSTANCE_BACKUP_ALERT_DAYS=8     # 0 disables the "no backup" alert
# NIXPLOY_DOCKER_CLEANUP_CRON=0 4 * * 0    # unset = the weekly prune is off

# ── optional: tests ──────────────────────────────────────────────────────────
# The tenancy isolation suite (13 tests) SKIPS silently without this.
# DATABASE_URL_TEST=postgres://nixploy:nixploy@127.0.0.1:54329/nixploy_test
