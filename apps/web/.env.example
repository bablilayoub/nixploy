# Copy to apps/web/.env and fill secrets (see CONTRIBUTING.md).
#
# With the throwaway Postgres from the docs:
#   docker run -d --name nixploy-dev-pg \
#     -e POSTGRES_USER=nixploy -e POSTGRES_PASSWORD=nixploy -e POSTGRES_DB=nixploy \
#     -p 54329:5432 postgres:17-alpine
DATABASE_URL=postgres://nixploy:nixploy@127.0.0.1:54329/nixploy

# openssl rand -hex 24
BETTER_AUTH_SECRET=change-me-to-a-random-32-char-string
# openssl rand -hex 16
ENCRYPTION_KEY=change-me-32-byte-hex-key-for-secrets-at-rest

# Public base URL (auth callbacks / trusted origin)
BETTER_AUTH_URL=http://localhost:3000

# Optional
# PORT=3000
# NIXPLOY_CONFIG_DIR=/absolute/path/to/repo/.nixploy-data
# NIXPLOY_NETWORK=nixploy-network
