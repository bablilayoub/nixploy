{
	"name": "@nixploy/web",
	"version": "0.7.3",
	"private": true,
	"scripts": {
		"dev": "NODE_OPTIONS='--max-old-space-size=8192' tsx watch server.ts",
		"build": "next build",
		"start": "NODE_ENV=production tsx server.ts",
		"worker": "NIXPLOY_ROLE=worker tsx worker.ts",
