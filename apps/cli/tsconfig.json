{
	// Same shared strictness as the panel and the server; see tsconfig.base.json.
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"types": ["node"],
		// The CLI ships with one runtime dependency (commander) and no test
		// runner of its own: `pnpm -F @nixploy/cli test` borrows the vitest
		// binary from @nixploy/server. Point the type resolver at the same
		// copy so `*.test.ts` typechecks without adding a dev dependency.
		"paths": {
			"vitest": ["../../packages/server/node_modules/vitest/dist/index.d.ts"]
		}
	},
	"include": ["src", "vitest.config.ts"]
}
