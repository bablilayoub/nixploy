{
	"name": "@nixploy/cli",
	"version": "0.1.0",
	"description": "Command-line interface for Nixploy — manage projects, apps, databases and env vars from your terminal",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"nixploy": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"engines": {
		"node": ">=22"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bablilayoub/nixploy.git",
		"directory": "apps/cli"
	},
	"homepage": "https://github.com/bablilayoub/nixploy/tree/main/apps/cli",
	"bugs": {
		"url": "https://github.com/bablilayoub/nixploy/issues"
	},
	"keywords": [
		"nixploy",
		"paas",
		"cli",
		"docker",
		"self-hosted",
		"deploy"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm run typecheck && pnpm run build"
	},
	"dependencies": {
		"commander": "^13.1.0"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"tsup": "^8.3.5",
		"typescript": "^5.7.2"
	}
}
