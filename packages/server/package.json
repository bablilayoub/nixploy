{
	"name": "@nixploy/server",
	"version": "0.7.3",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./db": "./src/db/index.ts",
		"./schema": "./src/db/schema/index.ts",
		"./auth": "./src/lib/auth.ts",
		"./lib/*": "./src/lib/*.ts",
		"./exec": "./src/utils/exec.ts",
		"./encryption": "./src/lib/encryption.ts",
		"./trpc": "./src/trpc/root.ts",
		"./trpc/*": "./src/trpc/*.ts",
		"./modules/projects": "./src/modules/projects/index.ts",
		"./modules/*": "./src/modules/*.ts",
		"./modules/*/*": "./src/modules/*/*.ts",
		"./utils/*": "./src/utils/*.ts",
		"./ws": "./src/ws/index.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test:db": "node ../../tools/test-db.mjs",
		"nixploy:rotate-key": "tsx src/scripts/rotate-encryption-key.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@better-auth/api-key": "1.7.3",
		"@better-auth/passkey": "1.7.10",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@octokit/auth-app": "^8.3.1",
		"@octokit/webhooks": "^14.2.0",
		"@trpc/server": "^11.19.0",
		"adm-zip": "^0.6.1",
		"bcryptjs": "^3.0.2",
		"better-auth": "1.7.3",
		"dockerode": "^5.0.1",
		"drizzle-orm": "^0.45.4",
		"drizzle-zod": "^0.8.2",
		"node-schedule": "^2.1.1",
		"nodemailer": "^10.1.1",
		"octokit": "^5.0.5",
		"postgres": "^3.4.5",
		"simple-git": "^4.0.2",
		"ssh2": "^1.16.0",
		"superjson": "^2.2.6",
		"ws": "^8.22.0",
		"yaml": "^2.9.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/adm-zip": "^0.6.0",
		"@types/dockerode": "^4.0.2",
		"@types/node": "^22.20.5",
		"@types/node-schedule": "^2.1.8",
		"@types/ssh2": "^1.15.6",
		"@types/ws": "^8.18.2",
		"drizzle-kit": "^0.31.11",
		"tsx": "^4.23.15",
		"typescript": "^7.0.2",
		"vitest": "^5.0.5"
	}
}
