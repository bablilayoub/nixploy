{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/dist",
			"!**/build",
			"!**/coverage",
			"!packages/server/drizzle",
			"!.nixploy-data"
		]
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useOptionalChain": "error"
			},
			"correctness": {
				"noUnusedFunctionParameters": "error",
				"noUnusedImports": "error",
				"noUnusedInstantiation": "error",
				"noUnusedPrivateClassMembers": "error",
				"noUnusedVariables": "error"
			},
			"performance": {
				"noAccumulatingSpread": "error"
			},
			"style": {
				"noCommonJs": "error",
				"noNonNullAssertion": "error",
				"noParameterAssign": "error",
				"useConst": "error",
				"useExportType": "error",
				"useImportType": "error",
				"useNodejsImportProtocol": "error",
				"useThrowNewError": "error",
				"useThrowOnlyError": "error"
			},
			"suspicious": {
				"noConfusingVoidType": "error",
				"noEvolvingTypes": "error",
				"noExplicitAny": "error",
				"noReturnAssign": "error",
				"noSkippedTests": "error",
				"noTsIgnore": "error",
				"useErrorMessage": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": [
				"packages/server/src/modules/**",
				"!packages/server/src/modules/**/*.test.ts",
				"!packages/server/src/modules/mcp/server.ts",
				"!packages/server/src/modules/deployment/docker.ts",
				"!packages/server/src/modules/backups/stream-exec.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@trpc/server": "Modules must not import @trpc/server: throw a DomainError from modules/errors.ts (badRequest, notFound, conflict, …) and trpc/init.ts maps it to the right code for tRPC, REST and MCP.",
									"node:child_process": "Feature code must not spawn processes directly: use execAsync / execAsyncRemote / execAsyncWithStdin (utils/exec.ts) or spawnTargeted (modules/deployment/docker.ts) so quoting, timeouts and the remote/local split stay in one place.",
									"child_process": "Feature code must not spawn processes directly: use execAsync / execAsyncRemote / execAsyncWithStdin (utils/exec.ts) or spawnTargeted (modules/deployment/docker.ts) so quoting, timeouts and the remote/local split stay in one place."
								}
							}
						}
					}
				}
			}
		},
		{
			"includes": ["apps/web/src/app/swagger/swagger-theme.css"],
			"linter": {
				"rules": {
					"style": {
						"noDescendingSpecificity": "off"
					}
				}
			}
		}
	]
}
