{
	"name": "nixploy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -F @nixploy/server exec vitest run",
		"test:template-images": "TEMPLATE_IMAGE_CHECK=1 pnpm -F @nixploy/server exec vitest run src/modules/templates/images-health.test.ts",
		"smoke:golden-path": "node tools/golden-path-api.mjs",
		"db:generate": "pnpm -F @nixploy/server db:generate",
		"db:migrate": "pnpm -F @nixploy/server db:migrate",
		"db:push": "pnpm -F @nixploy/server db:push",
		"db:studio": "pnpm -F @nixploy/server db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.2",
		"typescript": "^5.9.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		],
		"overrides": {
			"tar": ">=7.5.22",
			"postcss": ">=8.5.23",
			"brace-expansion@1": ">=1.1.18",
			"brace-expansion@5": ">=5.0.9",
			"fast-uri": ">=3.1.5",
			"esbuild": ">=0.25.0",
			"sharp": ">=0.35.3"
		}
	}
}
