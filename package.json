{
	"name": "nixploy",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.33.0",
	"engines": {
		"node": ">=22.0.0",
		"pnpm": ">=10.0.0"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm -r --parallel dev",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"typecheck": "pnpm -r typecheck",
		"test": "pnpm -F @nixploy/server exec vitest run",
		"db:generate": "pnpm -F @nixploy/server db:generate",
		"db:migrate": "pnpm -F @nixploy/server db:migrate",
		"db:push": "pnpm -F @nixploy/server db:push",
		"db:studio": "pnpm -F @nixploy/server db:studio"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.1.2",
		"typescript": "^5.9.2"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"bcrypt",
			"esbuild"
		]
	}
}
